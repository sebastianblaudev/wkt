# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# Supabase connection (production). Use the service_role key from your
# Supabase project settings. ROTATE this key if it was ever committed.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Master key for super-admin operations. Use a long, random string.
SUPER_ADMIN_KEY=

# Secret used to derive per-channel WebRTC signaling keys (HMAC).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SIGNAL_SECRET=

# Comma-separated list of allowed CORS origins (frontend). Leave empty for local dev.
ALLOWED_ORIGINS=

# TURN servers for WebRTC behind restrictive NAT/cellular networks.
# Recommended: run coturn via docker-compose.yml and let the server mint
# ephemeral credentials (TURN_SECRET shared with coturn). The browser never
# sees the secret. Optional build-time override below still works.
TURN_SECRET=
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_EXTERNAL_IP=
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Port for the server (optional, Render sets this automatically).
PORT=3000

# --- Production INFRASTRUCTURE ---

# --- Supabase Connection (Production) ---
SUPABASE_URL=https://vzzjkoviyodurlzsiiup.supabase.co
# Replace with NEW SUPABASE_SERVICE_KEY (regenerate via Supabase dashboard)
SUPABASE_SERVICE_KEY=PLEASE_REGENERATE_AND_INSERT_KEY_HERE

# --- Master key for super-admin operations ---
SUPER_ADMIN_KEY=4ObG8iPM6scyxoKLP3yxRJuvtFDK4NOiOo-Oo-6HzjHktg

# --- SIGNAL_SECRET for WebRTC key derivation ---
SIGNAL_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING

# --- AI Provider (Kimi Moonshot OpenAI-compatible) ---
AI_PROVIDER_URL=https://api.moonshot.cn/v1/chat/completions
# Insert NEW Kimi API key from: https://moonshot.ai/en-US/docs/start
AI_API_KEY=INSERT_NEW_KIMI_API_KEY_HERE
AI_MODEL=kimi-k2.6

# --- Production TURN (Metered / Twilio) ---
TURN_STATIC_URLS=turn:your-metered-turn-url:3478?transport=udp,turn:your-metered-turn-url:3478?transport=tcp
TURN_STATIC_USER=YOUR_METERED_USERNAME
TURN_STATIC_PASS=YOUR_METERED_PASSWORD

# --- Optional Override for Ephemeral TURN (if running own coturn) ---
# TURN_SECRET=SET_YOUR_INTERNAL_TURN_SECRET
# TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# TURN_EXTERNAL_IP=YOUR_PUBLIC_IP

